@page "/buyer/chat/{SessionId:guid}"
@page "/seller/chat/{SessionId:guid}"
@using Microsoft.AspNetCore.SignalR.Client
@inject HttpClient Http
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider
@inject TokenAuthenticationStateProvider TokenProvider
@implements IAsyncDisposable

<PageTitle>Chat — M-TAU</PageTitle>

<MudPaper Elevation="2" Class="d-flex flex-column" Style="height:calc(100vh - 200px); overflow:hidden;">
    @* Header *@
    <MudAppBar Color="Color.Default" Fixed="false" Dense="true" Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                       Href="/buyer/chat" aria-label="Voltar para negociações" />
        <MudText Typo="Typo.h6" Class="ml-2">Negociação</MudText>
        <MudSpacer />
        @if (_connected)
        {
            <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.Circle">Online</MudChip>
        }
        else
        {
            <MudChip T="string" Color="Color.Warning" Size="Size.Small" Icon="@Icons.Material.Filled.Circle">Conectando…</MudChip>
        }
    </MudAppBar>

    @* Messages *@
    <div id="chat-messages" role="log" aria-live="polite" aria-label="Mensagens do chat"
         style="flex:1; overflow-y:auto; padding:16px;">
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            @foreach (var msg in _messages)
            {
                <ChatBubble Message="@msg" IsOwn="@(msg.SenderId == _currentUserId)" />
            }
        }
    </div>

    @* Input *@
    <MudDivider />
    <div class="pa-3 d-flex gap-2">
        <MudTextField @bind-Value="_newMessage" Placeholder="Digite uma mensagem…"
                      Variant="Variant.Outlined" Margin="Margin.Dense"
                      Style="flex:1;"
                      OnKeyDown="HandleKeyDown"
                      aria-label="Campo de mensagem"
                      autocomplete="off" />
        <MudIconButton Icon="@Icons.Material.Filled.Send" Color="Color.Primary"
                       OnClick="SendAsync" Disabled="@(_sending || !_connected)"
                       aria-label="Enviar mensagem" />
    </div>
</MudPaper>

@code {
    [Parameter] public Guid SessionId { get; set; }

    private List<MessageResponseDto> _messages = [];
    private bool _loading = true;
    private bool _sending;
    private bool _connected;
    private string _newMessage = string.Empty;
    private Guid _currentUserId;
    private HubConnection? _hub;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var sub = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (Guid.TryParse(sub, out var id))
            _currentUserId = id;

        try
        {
            var session = await Http.GetFromJsonAsync<ChatSessionResponseDto>($"api/chatsessions/{SessionId}");
            _messages = session?.Messages?.OrderBy(m => m.SentAt).ToList() ?? [];
        }
        catch
        {
            Snackbar.Add("Erro ao carregar mensagens.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }

        await ConnectHubAsync();
    }

    private async Task ConnectHubAsync()
    {
        var baseUri = Http.BaseAddress ?? new Uri(Nav.BaseUri);
        var hubUri = new Uri(baseUri, "hubs/chat");

        _hub = new HubConnectionBuilder()
            .WithUrl(hubUri, options =>
            {
                options.AccessTokenProvider = async () => await TokenProvider.GetTokenAsync();
            })
            .WithAutomaticReconnect()
            .Build();

        _hub.On<MessageResponseDto>("ReceiveMessage", msg =>
        {
            if (!_messages.Any(m => m.Id == msg.Id))
            {
                _messages.Add(msg);
                InvokeAsync(StateHasChanged);
            }
        });

        _hub.Reconnected += async _ =>
        {
            await _hub!.SendAsync("JoinSession", SessionId);
        };

        try
        {
            await _hub.StartAsync();
            await _hub.SendAsync("JoinSession", SessionId);
            _connected = true;
        }
        catch
        {
            Snackbar.Add("Falha ao conectar ao chat em tempo real.", Severity.Warning);
        }
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_newMessage) || _hub is null) return;
        _sending = true;
        try
        {
            var dto = new MessageCreateDto(SessionId, _currentUserId, _newMessage);
            await _hub.SendAsync("SendMessage", dto);
            _newMessage = string.Empty;
        }
        catch
        {
            Snackbar.Add("Erro ao enviar mensagem.", Severity.Error);
        }
        finally
        {
            _sending = false;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await SendAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
        {
            try { await _hub.SendAsync("LeaveSession", SessionId); } catch { }
            await _hub.DisposeAsync();
        }
    }
}
