@page "/buyer/orders/{Id:guid}"
@inject HttpClient Http
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Detalhes do Pedido — M-TAU</PageTitle>

<MudBreadcrumbs Items="@_breadcrumbs" Class="mb-4" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_order is null)
{
    <MudAlert Severity="Severity.Error">Pedido não encontrado.</MudAlert>
}
else
{
    <MudGrid>
        <MudItem xs="12" md="8">
            <MudCard Elevation="2" Class="pa-4">
                <MudCardHeader>
                    <MudText Typo="Typo.h6">Pedido #@_order.Id.ToString()[..8]</MudText>
                </MudCardHeader>
                <MudCardContent>
                    <MudList T="string" Dense="true">
                        <MudListItem Icon="@Icons.Material.Filled.ShoppingBag">
                            Produto: @_order.ProductId
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.CalendarToday">
                            Data: @_order.OrderDate.ToString("dd/MM/yyyy HH:mm")
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.AttachMoney">
                            Valor: @_order.TotalAmount.ToString("C2")
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Info">
                            Status: <StatusBadge Status="@_order.Status.ToString()" />
                        </MudListItem>
                    </MudList>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                               OnClick="@(() => Nav.NavigateTo($"/catalog/{_order.ProductId}"))">
                        Ver produto
                    </MudButton>
                    @if (_order.Status == OrderStatus.Completed)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.Star"
                                   OnClick="@(() => Nav.NavigateTo($"/buyer/feedback/{_order.Id}"))"
                                   aria-label="Avaliar negociação">
                            Avaliar negociação
                        </MudButton>
                    }
                </MudCardActions>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudCard Elevation="2" Class="pa-4">
                <MudCardHeader>
                    <MudText Typo="Typo.h6">Linha do tempo</MudText>
                </MudCardHeader>
                <MudCardContent>
                    <MudTimeline TimelineAlign="TimelineAlign.Start">
                        @foreach (var step in _steps)
                        {
                            <MudTimelineItem Color="@step.Color" Size="Size.Small">
                                <MudText Typo="Typo.body2">@step.Label</MudText>
                            </MudTimelineItem>
                        }
                    </MudTimeline>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private OrderResponseDto? _order;
    private bool _loading = true;
    private List<BreadcrumbItem> _breadcrumbs = [];
    private List<(string Label, Color Color)> _steps = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _order = await Http.GetFromJsonAsync<OrderResponseDto>($"api/orders/{Id}");
        }
        catch
        {
            _order = null;
        }
        finally
        {
            _loading = false;
            _breadcrumbs =
            [
                new("Início", "/"),
                new("Meus Pedidos", "/buyer/orders"),
                new("Detalhes", null, disabled: true)
            ];
            if (_order is not null)
                _steps = BuildSteps(_order.Status);
        }
    }

    private static List<(string, Color)> BuildSteps(OrderStatus status) =>
    [
        ("Pedido realizado", Color.Success),
        ("Confirmado", status >= OrderStatus.Confirmed ? Color.Success : Color.Default),
        ("Concluído", status == OrderStatus.Completed ? Color.Success : Color.Default),
        ("Cancelado", status == OrderStatus.Cancelled ? Color.Error : Color.Default),
    ];
}
