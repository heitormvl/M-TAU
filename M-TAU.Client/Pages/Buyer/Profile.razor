@page "/buyer/profile"
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Meu Perfil — M-TAU</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Meu Perfil</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudGrid>
        <MudItem xs="12" md="8">
            <MudCard Elevation="2" Class="pa-4">
                <MudCardContent>
                    <EditForm Model="_model" OnValidSubmit="SaveAsync">
                        <DataAnnotationsValidator />
                        <MudStack Spacing="3">
                            <MudTextField @bind-Value="_model.Name" Label="Nome completo"
                                          Variant="Variant.Outlined"
                                          For="@(() => _model.Name)"
                                          aria-label="Nome completo" />
                            <MudTextField @bind-Value="_model.Email" Label="E-mail"
                                          Variant="Variant.Outlined" InputType="InputType.Email"
                                          For="@(() => _model.Email)"
                                          aria-label="Endereço de e-mail" />
                            <MudDivider />
                            <MudText Typo="Typo.subtitle2">Localização</MudText>
                            <CepLookup @bind-Cep="_cep" @bind-City="_city" @bind-Neighborhood="_neighborhood" />
                            <ValidationSummary />
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                                       Color="Color.Primary" Disabled="_saving"
                                       aria-label="Salvar alterações">
                                @(_saving ? "Salvando…" : "Salvar alterações")
                            </MudButton>
                        </MudStack>
                    </EditForm>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudCard Elevation="2" Class="pa-4">
                <MudCardContent>
                    <MudText Typo="Typo.h6" GutterBottom="true">Avaliação média</MudText>
                    <div class="d-flex align-center gap-2">
                        <RatingStars Value="@_avgRating" ReadOnly="true" />
                        <MudText>@_avgRating.ToString("0.0") / 5</MudText>
                    </div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Baseado em @_reviewCount avaliação(ões)
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}

@code {
    private readonly ProfileModel _model = new();
    private bool _saving;
    private bool _loading = true;
    private string _cep = string.Empty;
    private string _city = string.Empty;
    private string _neighborhood = string.Empty;
    private int _avgRating = 0;
    private int _reviewCount = 0;
    private Guid _currentUserId;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var sub = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (Guid.TryParse(sub, out var id))
            _currentUserId = id;

        try
        {
            var user = await Http.GetFromJsonAsync<UserResponseDto>($"api/users/{_currentUserId}");
            if (user is not null)
            {
                _model.Name = user.Name;
                _model.Email = user.Email;
            }
        }
        catch { }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            var nameResponse = await Http.PutAsJsonAsync(
                $"api/users/{_currentUserId}/name", new { Name = _model.Name });
            var emailResponse = await Http.PutAsJsonAsync(
                $"api/users/{_currentUserId}/email", new { Email = _model.Email });

            if (nameResponse.IsSuccessStatusCode && emailResponse.IsSuccessStatusCode)
                Snackbar.Add("Perfil atualizado com sucesso!", Severity.Success);
            else
                Snackbar.Add("Erro ao atualizar perfil.", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed class ProfileModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(120, MinimumLength = 2)]
        public string Name { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = string.Empty;
    }
}
