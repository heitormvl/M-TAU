@page "/seller/products"
@inject HttpClient Http
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Meus Anúncios — M-TAU</PageTitle>

<div class="d-flex align-center justify-space-between mb-4">
    <MudText Typo="Typo.h4">Meus Anúncios</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               Href="/seller/products/new"
               aria-label="Criar novo anúncio">
        Novo anúncio
    </MudButton>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_products is null || _products.Count == 0)
{
    <MudAlert Severity="Severity.Info">Você ainda não tem anúncios.
        <MudLink Href="/seller/products/new">Criar primeiro anúncio</MudLink>
    </MudAlert>
}
else
{
    <MudTable Items="_products" Hover="true" Dense="false" Striped="true"
              aria-label="Tabela de anúncios">
        <HeaderContent>
            <MudTh>Título</MudTh>
            <MudTh>Preço</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Ações</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Título">@context.Title</MudTd>
            <MudTd DataLabel="Preço">@context.Price.ToString("C2")</MudTd>
            <MudTd DataLabel="Status"><StatusBadge Status="@context.Status.ToString()" /></MudTd>
            <MudTd DataLabel="Ações">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               Color="Color.Primary"
                               OnClick="@(() => Nav.NavigateTo($"/seller/products/{context.Id}/edit"))"
                               aria-label="@($"Editar {context.Title}")" />
                <MudIconButton Icon="@(context.Status == ProductStatus.Active ? Icons.Material.Filled.Pause : Icons.Material.Filled.PlayArrow)"
                               Size="Size.Small" Color="Color.Warning"
                               OnClick="@(() => TogglePauseAsync(context))"
                               aria-label="@(context.Status == ProductStatus.Active ? "Pausar" : "Reativar")" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                               Color="Color.Error"
                               OnClick="@(() => ConfirmDeleteAsync(context))"
                               aria-label="@($"Excluir {context.Title}")" />
            </MudTd>
        </RowTemplate>
    </MudTable>
    <Pagination CurrentPage="_currentPage" TotalPages="_totalPages" PageChanged="OnPageChanged" />
}

@code {
    private IReadOnlyCollection<ProductResponseDto>? _products;
    private bool _loading = true;
    private int _currentPage = 1;
    private int _totalPages = 1;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            // TODO: filtrar por sellerId autenticado
            _products = await Http.GetFromJsonAsync<IReadOnlyCollection<ProductResponseDto>>(
                $"api/products?pageNumber={_currentPage}&pageSize=15") ?? [];
        }
        catch
        {
            _products = [];
        }
        finally { _loading = false; }
    }

    private async Task TogglePauseAsync(ProductResponseDto product)
    {
        var newStatus = product.Status == ProductStatus.Active ? ProductStatus.Paused : ProductStatus.Active;
        await Http.PatchAsJsonAsync($"api/products/{product.Id}/status", new { status = newStatus });
        await LoadAsync();
    }

    private async Task ConfirmDeleteAsync(ProductResponseDto product)
    {
        await Http.DeleteAsync($"api/products/{product.Id}");
        Snackbar.Add($"Anúncio \"{product.Title}\" excluído.", Severity.Success);
        await LoadAsync();
    }

    private async Task OnPageChanged(int page)
    {
        _currentPage = page;
        await LoadAsync();
    }
}
