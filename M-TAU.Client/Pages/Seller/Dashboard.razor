@page "/seller/dashboard"
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Dashboard — M-TAU Vendedor</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Dashboard do Vendedor</MudText>

<MudGrid Class="mb-6">
    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="2">
            <MudCardContent Class="d-flex align-center gap-3">
                <MudIcon Icon="@Icons.Material.Filled.Inventory" Color="Color.Primary" Style="font-size:2.5rem;" />
                <div>
                    <MudText Typo="Typo.caption">Anúncios ativos</MudText>
                    <MudText Typo="Typo.h5">@_activeProducts</MudText>
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="2">
            <MudCardContent Class="d-flex align-center gap-3">
                <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Color="Color.Warning" Style="font-size:2.5rem;" />
                <div>
                    <MudText Typo="Typo.caption">Pedidos pendentes</MudText>
                    <MudText Typo="Typo.h5">@_pendingOrders</MudText>
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="2">
            <MudCardContent Class="d-flex align-center gap-3">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Style="font-size:2.5rem;" />
                <div>
                    <MudText Typo="Typo.caption">Vendas concluídas</MudText>
                    <MudText Typo="Typo.h5">@_completedOrders</MudText>
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="2">
            <MudCardContent Class="d-flex align-center gap-3">
                <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" Style="font-size:2.5rem;" />
                <div>
                    <MudText Typo="Typo.caption">Avaliação média</MudText>
                    <RatingStars Value="@((int)Math.Round(_avgRating))" ReadOnly="true" />
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

<MudStack Row="true" Spacing="2" Class="mb-4">
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               Href="/seller/products/new"
               aria-label="Criar novo anúncio">
        Novo anúncio
    </MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
               Href="/seller/products"
               aria-label="Ver todos os anúncios">
        Meus anúncios
    </MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
               Href="/seller/orders"
               aria-label="Ver pedidos recebidos">
        Pedidos recebidos
    </MudButton>
</MudStack>

@code {
    private int _activeProducts;
    private int _pendingOrders;
    private int _completedOrders;
    private double _avgRating = 4.0;

    protected override async Task OnInitializedAsync()
    {
        // TODO: carregar métricas reais da API com sellerId autenticado
        await Task.CompletedTask;
    }
}
